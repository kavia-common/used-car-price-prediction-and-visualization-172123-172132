# Environment configuration for Car Price ML Backend

# Path to the serialized model artifact. The app will look for this file at startup.
# If TRAIN_ON_START=true and DATA_PATH exists, a model will be trained and saved here.
MODEL_PATH=models/model.joblib

# Path to the CSV data used for training. Ensure car_data.csv is placed here or update the path accordingly.
DATA_PATH=data/car_data.csv

# When true, the app will attempt to train a model on startup if DATA_PATH exists and MODEL_PATH is missing.
# Accepted truthy values: "1", "true", "yes", "on"
TRAIN_ON_START=true

# CORS configuration. Comma-separated list or "*" for all origins.
# Example: "http://localhost:3000,https://your-frontend.app"
ALLOWED_ORIGINS=*

# Model type selector: "rf" (RandomForestRegressor) or "linear" (LinearRegression)
# You may also set "random_forest" and the app will normalize it to RF behavior.
MODEL_TYPE=random_forest

# Optional: API title/version overrides for OpenAPI docs
# API_TITLE=Car Price ML API
# API_VERSION=v1
